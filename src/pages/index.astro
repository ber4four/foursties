---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import BlogCard from '../components/BlogCard.astro';
import { getPublishedPosts } from '../lib/notion';

// Ambil 3 artikel terbaru untuk section Blog Terbaru di Homepage
const allPosts = await getPublishedPosts();
const latestPosts = allPosts.slice(0, 3);

const homepageMetaDesc = "Solusi Anak Lalap Makan (Anti-GTM), Inovasi Tekstur & Sensori MPASI, serta Trik Menambah Kalori & Protein Harian bagi Ibu Bekerja & Ibu Modern Balita 8–24 Bulan.";
---

<Layout
  title="Kremes_Pedia | Solusi Anak Lahap Makan (Anti-GTM) & Inovasi MPASI Balita"
  description={homepageMetaDesc}
  canonical="/"
>
  <!-- Hero Section -->
  <Hero />

  <!-- Section 1: Fitur Unggulan / Why Choose Us (3 Poin Utama) -->
  <section class="py-20 bg-surface-card dark:bg-surface-dark-card border-y border-brand-cream/60 dark:border-surface-dark-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-peach/20 text-brand-green dark:text-brand-cream mb-3">
          Mengapa Ibu Cerdas Memilih Kami?
        </span>
        <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-[#1C3A18] dark:text-[#FFF9F0]">
          3 Alasan Kremes_Pedia Jadi Sahabat Piring Bersih Si Kecil
        </h2>
        <p class="text-base text-[#5F6D61] dark:text-[#A8BBAA] mt-3">
          Diriset mendalam untuk menjawab keresahan ibu bekerja saat balita menolak makan: cepat, sehat, dan disukai anak.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Poin 1: Sensori Tekstur Optimal -->
        <div class="relative p-8 rounded-3xl bg-brand-cream-light/70 dark:bg-surface-dark border border-brand-cream/80 dark:border-surface-dark-border shadow-soft hover:shadow-pastel transition-all duration-300 hover:-translate-y-1">
          <div class="w-14 h-14 rounded-2xl bg-brand-peach/30 flex items-center justify-center text-3xl mb-6 shadow-sm">
            ✨
          </div>
          <h3 class="font-display font-bold text-xl text-[#1C3A18] dark:text-[#FFF9F0] mb-3">
            Inovasi Tekstur Sensori & Anti-Tersedak
          </h3>
          <p class="text-sm text-[#5F6D61] dark:text-[#A8BBAA] leading-relaxed">
            Tekstur renyah di awal gigitan yang merangsang sensorik motorik rahang balita, namun langsung lumer saat menyentuh air liur (quick-melt). Aman untuk gusi balita 8–24 bulan.
          </p>
          <div class="mt-4 pt-4 border-t border-brand-cream/60 dark:border-surface-dark-border text-xs font-bold text-brand-green dark:text-brand-cream">
            ✓ Mencegah kebiasaan anak mengemut makanan
          </div>
        </div>

        <!-- Poin 2: Booster Protein Hewani & Kalori -->
        <div class="relative p-8 rounded-3xl bg-brand-peach-light/50 dark:bg-surface-dark border border-brand-peach/40 dark:border-surface-dark-border shadow-soft hover:shadow-pastel transition-all duration-300 hover:-translate-y-1">
          <div class="w-14 h-14 rounded-2xl bg-brand-peach/40 flex items-center justify-center text-3xl mb-6 shadow-sm">
            🥩
          </div>
          <h3 class="font-display font-bold text-xl text-[#1C3A18] dark:text-[#FFF9F0] mb-3">
            Dobel Protein Hewani & Kaldu Murni
          </h3>
          <p class="text-sm text-[#5F6D61] dark:text-[#A8BBAA] leading-relaxed">
            Dibuat dari 100% daging sapi murni tanpa ampas serta rebusan tulang ayam kampung asli. Kaya zat besi heme untuk mencegah anemia dan mendongkrak berat badan optimal.
          </p>
          <div class="mt-4 pt-4 border-t border-brand-peach/40 dark:border-surface-dark-border text-xs font-bold text-brand-green dark:text-brand-cream">
            ✓ Tingkatkan densitas kalori per suapan
          </div>
        </div>

        <!-- Poin 3: 100% Aman MPASI (Non-MSG & Rendah Garam) -->
        <div class="relative p-8 rounded-3xl bg-brand-green-soft/70 dark:bg-surface-dark border border-brand-green/30 dark:border-surface-dark-border shadow-soft hover:shadow-pastel transition-all duration-300 hover:-translate-y-1">
          <div class="w-14 h-14 rounded-2xl bg-brand-green/20 flex items-center justify-center text-3xl mb-6 shadow-sm">
            🌿
          </div>
          <h3 class="font-display font-bold text-xl text-[#1C3A18] dark:text-[#FFF9F0] mb-3">
            0% Pengawet & Disesuaikan Ginjal Balita
          </h3>
          <p class="text-sm text-[#5F6D61] dark:text-[#A8BBAA] leading-relaxed">
            Bebas penguat rasa sintetis (MSG), tanpa pewarna kimia, serta kadar natrium terkontrol ketat sesuai batas rekomendasi IDAI dan WHO untuk bayi di bawah 2 tahun.
          </p>
          <div class="mt-4 pt-4 border-t border-brand-green/30 dark:border-surface-dark-border text-xs font-bold text-brand-green dark:text-brand-cream">
            ✓ Gurih alami murni dari rempah nusantara
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Section 2: Product Showcase Spotlight -->
  <section class="py-20 bg-surface-light dark:bg-surface-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-5 order-2 lg:order-1">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-green text-brand-cream mb-3">
            Varian Terlaris MPASI
          </span>
          <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-[#1C3A18] dark:text-[#FFF9F0] leading-tight mb-4">
            Duo Senjata Rahasia Piring Tandas: Kremesan & Abon Balita
          </h2>
          <p class="text-base text-[#5F6D61] dark:text-[#A8BBAA] mb-6 leading-relaxed">
            Kombinasi sempurna taburan gizi untuk ibu bekerja. Cukup simpan di toples kedap udara, bawa bekal ke daycare atau sajikan hangat dalam 5 detik di rumah.
          </p>

          <div class="space-y-4">
            <div class="p-4 rounded-2xl bg-white dark:bg-surface-dark-card border border-brand-cream/80 dark:border-surface-dark-border shadow-soft flex items-start gap-4">
              <span class="text-2xl p-2 rounded-xl bg-brand-cream/50">🍗</span>
              <div>
                <h3 class="text-base font-bold text-[#1C3A18] dark:text-[#FFF9F0]">Kremesan Ayam Kampung Organik</h3>
                <p class="text-xs text-[#5F6D61] dark:text-[#A8BBAA] mt-1">Ekstrak kaldu ayam kampung asli yang renyah gurih lumer. Solusi balita yang bosan dengan tekstur bubur lembek.</p>
              </div>
            </div>

            <div class="p-4 rounded-2xl bg-white dark:bg-surface-dark-card border border-brand-cream/80 dark:border-surface-dark-border shadow-soft flex items-start gap-4">
              <span class="text-2xl p-2 rounded-xl bg-brand-peach/30">🥩</span>
              <div>
                <h3 class="text-base font-bold text-[#1C3A18] dark:text-[#FFF9F0]">Abon Sapi Halus MPASI (Iron-Rich)</h3>
                <p class="text-xs text-[#5F6D61] dark:text-[#A8BBAA] mt-1">Daging sapi murni diproses dengan serat mikro halus anti-nyelip di gigi bayi. Sumber zat besi heme terbaik pencegah stunting.</p>
              </div>
            </div>
          </div>

          <div class="pt-8">
            <a
              href="/produk"
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-2xl bg-brand-green hover:bg-brand-green-light text-[#FFF9F0] text-sm font-bold shadow-green-glow transition-all"
            >
              <span>Lihat Detail Varian & Promo Bundling</span>
              <svg class="w-4 h-4 text-brand-cream" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>
          </div>
        </div>

        <div class="lg:col-span-7 order-1 lg:order-2">
          <div class="grid grid-cols-2 gap-4 sm:gap-6">
            <div class="space-y-4">
              <img
                src="https://images.unsplash.com/photo-1544816155-12df9643f363?auto=format&fit=crop&w=600&q=80"
                alt="Balita makan dengan lahap - Kremes_Pedia"
                loading="lazy"
                class="rounded-3xl shadow-soft object-cover w-full h-64 sm:h-72 border-2 border-brand-cream"
              />
              <div class="p-4 rounded-2xl bg-brand-cream/40 dark:bg-surface-dark-card border border-brand-cream text-center">
                <span class="text-2xl font-extrabold text-brand-green dark:text-brand-cream">100%</span>
                <p class="text-xs font-semibold text-[#5F6D61] dark:text-[#A8BBAA] mt-0.5">Daging & Kaldu Asli Murni</p>
              </div>
            </div>

            <div class="space-y-4 pt-8">
              <div class="p-4 rounded-2xl bg-brand-peach/20 dark:bg-surface-dark-card border border-brand-peach/40 text-center">
                <span class="text-2xl font-extrabold text-[#C97768]">5 Detik</span>
                <p class="text-xs font-semibold text-[#5F6D61] dark:text-[#A8BBAA] mt-0.5">Langsung Siap Saji Tabur</p>
              </div>
              <img
                src="https://images.unsplash.com/photo-1505253758473-96b7015fcd40?auto=format&fit=crop&w=600&q=80"
                alt="Persiapan MPASI Sehat Bayi"
                loading="lazy"
                class="rounded-3xl shadow-soft object-cover w-full h-64 sm:h-72 border-2 border-brand-cream"
              />
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Section 3: Section Blog Terbaru (Ambil 3 Post Terbaru dari Notion CMS) -->
  <section class="py-20 bg-surface-card dark:bg-surface-dark-card border-t border-brand-cream/60 dark:border-surface-dark-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-cream/80 text-brand-green dark:text-brand-cream mb-3">
            Edukasi Nutrisi & Anti-GTM
          </span>
          <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-[#1C3A18] dark:text-[#FFF9F0]">
            Artikel & Panduan Terbaru untuk Ibu Modern
          </h2>
          <p class="text-base text-[#5F6D61] dark:text-[#A8BBAA] mt-2 max-w-xl">
            Solusi berbasis ilmiah seputar GTM, stimulasi sensori oromotor, dan booster kalori praktis.
          </p>
        </div>

        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-sm font-bold text-brand-green dark:text-brand-cream hover:text-brand-peach transition-colors"
        >
          <span>Jelajahi Semua Artikel</span>
          <svg class="w-4 h-4 text-brand-peach" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
      </div>

      <!-- Grid 3 Post Terbaru -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {latestPosts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>

    </div>
  </section>

  <!-- Section 4: Testimonial Ibu Bekerja -->
  <section class="py-20 bg-surface-light dark:bg-surface-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-peach/20 text-brand-green dark:text-brand-cream mb-3">
          Kisah Nyata di Meja Makan
        </span>
        <h2 class="font-display font-extrabold text-3xl sm:text-4xl text-[#1C3A18] dark:text-[#FFF9F0]">
          Kata Mereka yang Telah Bebas dari Stres GTM
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-8 rounded-3xl bg-white dark:bg-surface-dark-card border border-brand-cream/80 dark:border-surface-dark-border shadow-soft">
          <div class="flex text-amber-400 mb-4">⭐⭐⭐⭐⭐</div>
          <p class="text-sm text-[#374438] dark:text-[#CBD5CD] italic leading-relaxed mb-6">
            "Sebagai ibu yang bekerja 9 to 5, pulang ke rumah dengar laporan anak gak mau makan itu bikin mau nangis. Sejak kenal Kremes_Pedia, anak 14 bulan saya yang tadinya GTM parah langsung lahap minta nambah. Piringnya tandas!"
          </p>
          <div class="flex items-center gap-3">
            <img class="w-10 h-10 rounded-full object-cover border-2 border-brand-peach" src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=100&q=80" alt="Ibu Sarah" />
            <div>
              <div class="text-xs font-bold text-[#1C3A18] dark:text-[#FFF9F0]">Sarah Amelia (29 th)</div>
              <div class="text-[11px] text-[#7A8A7C]">Product Manager & Ibu Balita 14 Bulan</div>
            </div>
          </div>
        </div>

        <div class="p-8 rounded-3xl bg-white dark:bg-surface-dark-card border border-brand-cream/80 dark:border-surface-dark-border shadow-soft">
          <div class="flex text-amber-400 mb-4">⭐⭐⭐⭐⭐</div>
          <p class="text-sm text-[#374438] dark:text-[#CBD5CD] italic leading-relaxed mb-6">
            "Abon sapinya halus banget dan baunya kaldu asli, bukan perisa tiruan. Anak saya gampang banget hoek kalau naik tekstur, tapi pas coba ini reflek kunyahnya langsung terlatih dengan baik."
          </p>
          <div class="flex items-center gap-3">
            <img class="w-10 h-10 rounded-full object-cover border-2 border-brand-peach" src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=100&q=80" alt="dr. Nadia" />
            <div>
              <div class="text-xs font-bold text-[#1C3A18] dark:text-[#FFF9F0]">Nadia Kusuma (31 th)</div>
              <div class="text-[11px] text-[#7A8A7C]">Dokter Umum & Ibu Balita 10 Bulan</div>
            </div>
          </div>
        </div>

        <div class="p-8 rounded-3xl bg-white dark:bg-surface-dark-card border border-brand-cream/80 dark:border-surface-dark-border shadow-soft">
          <div class="flex text-amber-400 mb-4">⭐⭐⭐⭐⭐</div>
          <p class="text-sm text-[#374438] dark:text-[#CBD5CD] italic leading-relaxed mb-6">
            "Kremesan ayam kampungnya beneran lumer di lidah. Gak bikin serik sama sekali. BB si kembar naik 700 gram dalam sebulan karena napsu makannya balik. Highly recommended buat working moms!"
          </p>
          <div class="flex items-center gap-3">
            <img class="w-10 h-10 rounded-full object-cover border-2 border-brand-peach" src="https://images.unsplash.com/photo-1580489944761-15a19d654956?auto=format&fit=crop&w=100&q=80" alt="Ibu Dinda" />
            <div>
              <div class="text-xs font-bold text-[#1C3A18] dark:text-[#FFF9F0]">Dinda Prasetyo (27 th)</div>
              <div class="text-[11px] text-[#7A8A7C]">Financial Analyst & Ibu Balita 18 Bulan</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 5: BIG CTA SECTION WAJIB -->
  <section class="py-20 bg-gradient-to-br from-brand-peach/30 via-brand-cream/40 to-brand-green/20 dark:from-surface-dark-card dark:to-surface-dark relative overflow-hidden">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-extrabold uppercase tracking-wider bg-brand-green text-brand-cream mb-4 shadow-sm">
        🔥 PROMO BUNDLE MPASI CERDAS MINGGU INI
      </span>

      <!-- Headline CTA Utama Sesuai Instruksi Wajib -->
      <h2 class="font-display font-extrabold text-3xl sm:text-4xl md:text-5xl text-[#1C3A18] dark:text-[#FFF9F0] leading-tight mb-6">
        Tabur Krenyesnya, Habiskan Nasinya! Coba Resep & Dapatkan Promo Spesial Sekarang
      </h2>

      <p class="text-base sm:text-lg text-[#374438] dark:text-[#CBD5CD] max-w-2xl mx-auto mb-10 leading-relaxed">
        Dapatkan bonus E-Book <em>"30 Resep MPASI Anti-GTM 5 Menit untuk Ibu Sibuk"</em> plus diskon hingga 25% untuk pemesanan paket starter pack minggu ini.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/produk"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4.5 rounded-2xl bg-brand-green hover:bg-brand-green-light text-[#FFF9F0] text-lg font-extrabold shadow-green-glow hover:shadow-soft-lg transform hover:-translate-y-1 transition-all duration-200"
        >
          <span>Klaim Promo Paket Starter Pack</span>
          <svg class="w-5 h-5 text-brand-cream" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>

        <a
          href="/resep"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4.5 rounded-2xl bg-white dark:bg-surface-dark-card hover:bg-brand-cream/40 text-[#1C3A18] dark:text-brand-cream text-lg font-bold border border-brand-cream shadow-soft transition-all"
        >
          <span>Lihat Contoh Resep</span>
        </a>
      </div>

      <div class="mt-8 flex items-center justify-center gap-6 text-xs text-[#5F6D61] dark:text-[#8FA091]">
        <span>✓ Garansi 100% Produk Fresh</span>
        <span>✓ Pengiriman Cepat Se-Indonesia</span>
        <span>✓ Konsultasi Gizi Gratis</span>
      </div>

    </div>
  </section>
</Layout>
