---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Beranda' },
  { href: '/blog', label: 'Solusi GTM & Blog' },
  { href: '/produk', label: 'Produk & Nutrisi' },
  { href: '/resep', label: 'Resep MPASI' },
  { href: '/about', label: 'Tentang Kami' },
];
---

<header class="sticky top-0 z-50 glass-nav border-b border-brand-cream/60 dark:border-surface-dark-border transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-brand-peach rounded-xl p-1">
        <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-brand-peach to-brand-cream flex items-center justify-center shadow-pastel group-hover:scale-105 transition-transform duration-200">
          <!-- Cute Bowl Icon -->
          <svg class="w-6 h-6 text-brand-green" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 11h16a8 8 0 0 1-16 0Z"></path>
            <path d="M12 3v4"></path>
            <path d="m8 5 2 2"></path>
            <path d="m16 5-2 2"></path>
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-display font-extrabold text-2xl tracking-tight text-brand-green dark:text-brand-cream group-hover:text-brand-peach transition-colors">
            Kremes<span class="text-brand-peach">_Pedia</span>
          </span>
          <span class="text-[11px] font-semibold text-brand-green/80 dark:text-brand-cream/70 -mt-1 tracking-wider uppercase">
            Sahabat Lahap Balita
          </span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`px-3.5 py-2 rounded-xl text-sm font-semibold transition-all duration-200 ${
                isActive
                  ? 'text-brand-green dark:text-brand-cream bg-brand-cream/40 dark:bg-surface-dark-card shadow-sm'
                  : 'text-[#4A5D4B] dark:text-[#A8BBAA] hover:text-brand-green dark:hover:text-brand-cream hover:bg-brand-cream/20 dark:hover:bg-brand-green/20'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Right Actions: Dark Mode Toggle & CTA -->
      <div class="hidden sm:flex items-center gap-3">
        <!-- Dark/Light Mode Button -->
        <button
          id="theme-toggle"
          type="button"
          aria-label="Ganti mode gelap/terang"
          class="p-2.5 rounded-xl text-brand-green dark:text-brand-cream bg-brand-cream/30 dark:bg-surface-dark-card hover:bg-brand-cream/60 dark:hover:bg-brand-green/30 border border-brand-cream/80 dark:border-brand-green/30 transition-all focus:outline-none focus:ring-2 focus:ring-brand-peach"
        >
          <!-- Sun Icon (shown in dark mode) -->
          <svg id="theme-toggle-sun" class="w-5 h-5 hidden" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path>
          </svg>
          <!-- Moon Icon (shown in light mode) -->
          <svg id="theme-toggle-moon" class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
          </svg>
        </button>

        <!-- Navbar CTA Button -->
        <a
          href="/produk"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-2xl bg-brand-green hover:bg-brand-green-light text-[#FFF9F0] text-sm font-bold shadow-green-glow hover:shadow-soft-lg transform hover:-translate-y-0.5 transition-all duration-200"
        >
          <span>Beli Promo</span>
          <svg class="w-4 h-4 text-brand-cream" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
      </div>

      <!-- Mobile Hamburger Button & Dark toggle -->
      <div class="flex items-center gap-2 md:hidden">
        <button
          id="theme-toggle-mobile"
          type="button"
          aria-label="Ganti mode tema"
          class="p-2 rounded-xl text-brand-green dark:text-brand-cream bg-brand-cream/30 dark:bg-surface-dark-card border border-brand-cream/60"
        >
          <svg class="w-5 h-5 sun-icon hidden" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
          <svg class="w-5 h-5 moon-icon" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
        </button>

        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Buka menu navigasi"
          aria-expanded="false"
          class="p-2 rounded-xl text-brand-green dark:text-brand-cream hover:bg-brand-cream/30 focus:outline-none"
        >
          <svg id="hamburger-icon" class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg id="close-icon" class="w-7 h-7 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-brand-cream/50 dark:border-surface-dark-border bg-surface-light dark:bg-surface-dark px-4 pt-3 pb-6 space-y-2">
    {navLinks.map((link) => {
      const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
      return (
        <a
          href={link.href}
          class={`block px-4 py-3 rounded-xl text-base font-semibold transition-colors ${
            isActive
              ? 'text-brand-green dark:text-brand-cream bg-brand-cream/40 dark:bg-surface-dark-card'
              : 'text-[#4A5D4B] dark:text-[#A8BBAA] hover:text-brand-green dark:hover:text-brand-cream hover:bg-brand-cream/20'
          }`}
        >
          {link.label}
        </a>
      );
    })}

    <div class="pt-3">
      <a
        href="/produk"
        class="w-full flex items-center justify-center gap-2 px-5 py-3.5 rounded-2xl bg-brand-green text-[#FFF9F0] text-center font-bold shadow-green-glow"
      >
        <span>Beli Paket Coba Promo Spesial</span>
        <svg class="w-4 h-4 text-brand-cream" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  // Setup Dark / Light Mode Toggle logic
  const themeToggle = document.getElementById('theme-toggle');
  const sunIcon = document.getElementById('theme-toggle-sun');
  const moonIcon = document.getElementById('theme-toggle-moon');

  const mobileToggle = document.getElementById('theme-toggle-mobile');

  function updateIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    if (sunIcon && moonIcon) {
      if (isDark) {
        sunIcon.classList.remove('hidden');
        moonIcon.classList.add('hidden');
      } else {
        sunIcon.classList.add('hidden');
        moonIcon.classList.remove('hidden');
      }
    }

    if (mobileToggle) {
      const mSun = mobileToggle.querySelector('.sun-icon');
      const mMoon = mobileToggle.querySelector('.moon-icon');
      if (mSun && mMoon) {
        if (isDark) {
          mSun.classList.remove('hidden');
          mMoon.classList.add('hidden');
        } else {
          mSun.classList.add('hidden');
          mMoon.classList.remove('hidden');
        }
      }
    }
  }

  function toggleTheme() {
    if (document.documentElement.classList.contains('dark')) {
      document.documentElement.classList.remove('dark');
      localStorage.setItem('theme', 'light');
    } else {
      document.documentElement.classList.add('dark');
      localStorage.setItem('theme', 'dark');
    }
    updateIcons();
  }

  themeToggle?.addEventListener('click', toggleTheme);
  mobileToggle?.addEventListener('click', toggleTheme);
  updateIcons();

  // Mobile Menu Logic
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  mobileBtn?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    if (isOpen) {
      mobileMenu?.classList.add('hidden');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      mobileBtn.setAttribute('aria-expanded', 'false');
    } else {
      mobileMenu?.classList.remove('hidden');
      hamburgerIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      mobileBtn.setAttribute('aria-expanded', 'true');
    }
  });
</script>
